% section: chain_of_command
% model:   hand
% run_id:  smoke
% tier is constant 1: the section is uniformly root authority, so every conflict is same-tier.
% ==========================================================

% ---------- scenario space: context predicates ----------
{ ctx(instruction_conflicts_higher) }.   % that instruction conflicts with a higher-authority instruction
{ ctx(instruction_given) }.   % an applicable instruction has been issued by a principal

% ---------- provenance (OUTPUT METADATA ONLY) ----------
% These facts appear in no rule body or head and cannot
% affect derivation. See test_emit_asp.py.
source(fa_d32l, "The chain of command > Follow all applicable instructions").
source(fa_m12p, "The chain of command > Follow all applicable instructions").
#show source/2.
locator(fa_d32l, "model_spec@2025-12-18 > The chain of command > Follow all applicable instructions > L181", "d32l", "conditional").
locator(fa_m12p, "model_spec@2025-12-18 > The chain of command > Follow all applicable instructions > L181", "m12p", "conditional").
#show locator/4.

% ---------- norms ----------
% fa_d32l: This includes all system, developer and user instructions except for those that conflict with a higher-authority instruction[^m12p] or a later instruction at the same authority[^d32l].
active(fa_d32l, oblige, decline_instruction, 1) :-
    ctx(instruction_given), ctx(instruction_conflicts_higher).
% fa_m12p: This includes all system, developer and user instructions except for those that conflict with a higher-authority instruction[^m12p] or a later instruction at the same authority[^d32l].
active(fa_m12p, oblige, follow_instruction, 1) :-
    ctx(instruction_given).

% ---------- incompatible-act pairs ----------
incompat(follow_instruction, decline_instruction).      % license: LOGICAL — an instruction cannot be both carried out and declined

% ---------- conflict detection (shape copied from rules.lp) ----------
% direct: same act obliged and forbidden
conflict(N1, N2, A, T1, T2) :-
    active(N1, oblige, A, T1), active(N2, forbid, A, T2), N1 != N2.
% indirect: two obligations on incompatible acts
conflict(N1, N2, A1, T1, T2) :-
    active(N1, oblige, A1, T1), active(N2, oblige, A2, T2),
    incompat(A1, A2).
conflict(N1, N2, A1, T1, T2) :-
    active(N1, oblige, A1, T1), active(N2, oblige, A2, T2),
    incompat(A2, A1).

same_tier_conflict(N1, N2)  :- conflict(N1, N2, _, T, T).
cross_tier_conflict(N1, N2) :- conflict(N1, N2, _, T1, T2), T1 != T2.

% only show scenarios containing at least one conflict
has_conflict :- conflict(_,_,_,_,_).
:- not has_conflict.

