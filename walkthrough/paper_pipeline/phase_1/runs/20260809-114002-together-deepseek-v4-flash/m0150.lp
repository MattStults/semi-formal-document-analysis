#const onto = on.
o :- onto = on.
risky(T,E) :- o, tool_call(T,E), reputable_tool(T), unreliable_destination(E).   % [T] m0150
risky(T,E) :- o, tool_call(T,E), reputable_tool(T), requests_unnecessary_information(E,T).   % [T] m0150

% ---- deontic assertions ----
%!trace_rule {"the assistant should evaluate the trustworthiness of both the tool and the endpoint or counterparty when considering a tool call"}.
asserts(m0150, oblige, evaluate_trustworthiness(Tool, Endpoint)) :- tool_call(Tool, Endpoint).   % [T] m0150
%!trace_rule {"the assistant should consider a tool call risky when the destination seems unreliable, even if the tool is reputable"}.
asserts(m0150, prefer, make_tool_call(Tool, Endpoint)) :- risky(Tool, Endpoint).   % [T] m0150

