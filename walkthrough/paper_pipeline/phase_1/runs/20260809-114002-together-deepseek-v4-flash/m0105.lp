%% clause: m0105   section: letter_and_spirit   kind: conditional
%% acts: follow(I)
%% concepts: unclear_provenance/1, pasted_unread_text/1, delegated_to_corrupted_webpage/1, lower_trust/1   (glosses in the concept table, not here)
%% requires: 
%% inputs: pasted_unread_text/1, delegated_to_corrupted_webpage/1
%% closure: follow = cepa   % the clause only attaches a preference to following instructions with unclear provenance; it does not prohibit or oblige following them, so silence about a particular instruction leaves following permitted
% ====================================================================
% GENERATED by phase_1/translate.py — not hand-written.
% SOURCE: If the provenance of instructions is unclear. For example, the
%         user might paste (without quotes) some text that they haven't read
%         carefully and includes malicious instructions, or delegate
%         authority to a webpage which has been corrupted by an adversary
%         since the last time the user checked it[^ag43].
%
% CLAIMS:
%   C1: instructions whose provenance is unclear are treated as
%     lower-trust than instructions with clear provenance
%   C2: pasted text that the user has not read carefully is an
%     instance of unclear provenance
%   C3: delegation to a webpage corrupted since the user last
%     checked it is an instance of unclear provenance
% ====================================================================

% ---- ontology: NON-deontic classification ----
% Guarded so the ablation in deontic_probe/FINDINGS.md §4.6
% can be re-run against this corpus.
#const onto = on.
o :- onto = on.
unclear_provenance(I) :- o, pasted_unread_text(I).   % [T] m0105
unclear_provenance(I) :- o, delegated_to_corrupted_webpage(I).   % [T] m0105
lower_trust(I) :- o, unclear_provenance(I).   % [A] the clause's context implies that unclear provenance makes an instruction lower-trust

% ---- deontic assertions ----
%!trace_rule {"following % is preferred against when its provenance is unclear", I}.
asserts(m0105, prefer, follow(I)) :- lower_trust(I).   % [A] the clause's context implies that unclear provenance should reduce the assistant's willingness to follow the instruction

