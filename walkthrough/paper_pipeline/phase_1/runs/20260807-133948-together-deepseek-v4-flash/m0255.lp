%% clause: m0255   section: transformation_exception   kind: conditional
%% provides: lifted/2, unlifted/3, binds/2, violation/2, policy/1
%% requires: policy_class/2, scope/2, out_of_scope/2
%% inputs: forbids/2, produced/1, material_type/2, transformation_of_user_content/1, new_material/1
%% forbid-body: lifted <- purpose
% ====================================================================
% GENERATED by phase_1/translate.py — not hand-written.
% SOURCE: The transformation exception does not override any policies other
%         than those on [restricted](#restricted_content) or [sensitive
%         content](#sensitive_content); if other policies forbid producing
%         certain material, the assistant should still follow them[^ad81].
%         There is no “good cause” exception for the restricted and
%         sensitive content policies, and the assistant should not supply
%         new disallowed material even for seemingly legitimate research or
%         analysis purposes[^ad82]. The policy only applies to
%         *information*, not actions; the assistant should not perform a
%         prohibited action just because it's a "translation" of
%         user-provided content[^ad83].
%
% CLAIMS:
%   C1 the transformation exception's scope is exactly {restricted,
%     sensitive}
%   C2 policies outside that scope still bind
%   C3 purpose ('good cause', research, analysis) never lifts a
%     policy
%   C4 the exception covers INFORMATION only, never ACTIONS
% ====================================================================

% ---- facts, each with its licence ----
exception(transformation).   % [textual] cites m0255

% ---- rules ----
% K is named rather than `_`: the explainer cannot ground an anonymous
% variable
%!trace_rule {"% is a policy", P}.
policy(P) :- policy_class(P, K).

% C1 and C4 together. forbids(P,M) is in the body because a policy that
% does not forbid M was never engaged, and lifting it produced
% true-but-meaningless explanations
%!trace_rule {"% is lifted: the material is a transformation of user-supplied INFORMATION and % is inside the exception's scope", P, P}.
lifted(P, M) :- policy_class(P, K), scope(transformation, K), forbids(P, M), transformation_of_user_content(M), material_type(M, information).

% C2. Each way of failing to be lifted gets its OWN positive reason —
% deriving this from `not lifted` gave a right verdict with a wrong
% stated reason
%!trace_rule {"% is outside the transformation exception's scope", P}.
unlifted(P, M, out_of_scope) :- policy_class(P, K), out_of_scope(transformation, K), forbids(P, M).

%!trace_rule {"the exception covers information only, and % is an action", M}.
unlifted(P, M, is_an_action) :- forbids(P, M), material_type(M, action).

%!trace_rule {"% was not supplied by the user, so there is nothing to transform", M}.
unlifted(P, M, not_user_supplied) :- forbids(P, M), not transformation_of_user_content(M).

%!trace_rule {"% still binds", P}.
binds(P, M) :- unlifted(P, M, R).

% C3
%!trace_rule {"purpose gives no exemption: % is new disallowed material", M}.
binds(P, M) :- policy_class(P, restricted), forbids(P, M), new_material(M).

% C3
%!trace_rule {"purpose gives no exemption: % is new disallowed material", M}.
binds(P, M) :- policy_class(P, sensitive), forbids(P, M), new_material(M).

%!trace_rule {"producing % would violate %", M, P}.
violation(P, M) :- binds(P, M), produced(M).

% a test case asserting both was accepted and produced a confident
% answer from an impossible state
%!trace_rule {"the same policy cannot be both lifted and binding for the same material"}.
:- lifted(P, M), binds(P, M).

%!trace_rule {"supplying NEW disallowed material is not a transformation of anything"}.
:- new_material(M), transformation_of_user_content(M).

%!show_trace {lifted(A,B)}.
%!show_trace {unlifted(A,B,C)}.
%!show_trace {binds(A,B)}.
%!show_trace {violation(A,B)}.
%!show_trace {policy(A)}.
