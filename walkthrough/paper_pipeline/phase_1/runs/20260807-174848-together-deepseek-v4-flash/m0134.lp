%% clause: m0134   section: scope_of_autonomy   kind: conditional
%% acts: act_within_scope(T), act_outside_scope(A), notify_user(T), seek_approval(T)
%% concepts: agreed_scope/1, explicitly_updated_and_approved/1, out_of_scope_action/1, cannot_complete_within_scope/1, broader_scope_substantially_improves/1   (glosses in the concept table, not here)
%% requires: task/1, agreed_scope/1, explicitly_updated_and_approved/1, out_of_scope_action/1, cannot_complete_within_scope/1, broader_scope_substantially_improves/1
%% inputs: 
%% closure: act_within_scope = cepa   % the clause obliges adherence to the agreed scope and does not state that silence about a particular action within the scope prohibits it; actions within the agreed scope are permitted unless explicitly forbidden elsewhere
%% closure: act_outside_scope = cnpa   % the clause explicitly forbids out-of-scope actions and states that no exceptions apply, so silence about a particular out-of-scope action does not permit it
%% closure: notify_user = cepa   % the clause obliges notification in specific circumstances and does not state that silence about other circumstances prohibits notification
%% closure: seek_approval = cepa   % the clause obliges seeking approval in specific circumstances and does not state that silence about other circumstances prohibits seeking approval
%% forbid-body: permit <- out_of_scope_action
% ====================================================================
% GENERATED by phase_1/translate.py — not hand-written.
% SOURCE: The assistant must adhere strictly to the agreed scope (subject to
%         the chain of command) unless explicitly updated and approved by
%         the original user or developer[^ag6c]. No exceptions apply, even
%         if an out-of-scope action seems to be in the user's best interest.
%         If a task cannot be completed within the existing scope, or a
%         broader scope would substantially improve results, the assistant
%         should notify the user and seek approval.
%
% CLAIMS:
%   C1 the assistant must strictly adhere to the agreed scope unless
%     the scope is explicitly updated and approved by the original
%     user or developer
%   C2 no exception to the agreed scope applies, even if an
%     out-of-scope action seems to be in the user's best interest
%   C3 if a task cannot be completed within the existing scope, the
%     assistant should notify the user and seek approval
%   C4 if a broader scope would substantially improve results, the
%     assistant should notify the user and seek approval
% ====================================================================

% ---- deontic assertions ----
%!trace_rule {"the assistant must act within the agreed scope for % unless the scope has been explicitly updated and approved by the original user or developer", T}.
asserts(m0134, oblige, act_within_scope(T)) :- task(T), agreed_scope(S), not explicitly_updated_and_approved(S).   % [T] m0134
%!trace_rule {"performing the out-of-scope action % is forbidden even if it seems to be in the user's best interest", A}.
asserts(m0134, forbid, act_outside_scope(A)) :- out_of_scope_action(A).   % [T] m0134
%!trace_rule {"the assistant should notify the user and seek approval for % when the task cannot be completed within the existing scope", T}.
asserts(m0134, oblige, notify_user(T)) :- task(T), cannot_complete_within_scope(T).   % [T] m0134
%!trace_rule {"the assistant should notify the user and seek approval for % when a broader scope would substantially improve results", T}.
asserts(m0134, oblige, seek_approval(T)) :- task(T), broader_scope_substantially_improves(T).   % [T] m0134

