restricted_content(C) :- o, information_hazard(C).   % [T] l831_1000_n002
restricted_content(C) :- o, sensitive_personal_data(C).   % [T] l831_1000_n002
transformation_of_user_provided_restricted_content(C) :- o, transforms_user_provided_restricted_content(C, U), user_provided_restricted_content(U).   % [T] l831_1000_n002

