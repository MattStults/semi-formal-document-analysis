%!trace_rule {"an assistant response that provides legitimate official guidance is preferred"}.
asserts(l461_608_n024, prefer, provide_legitimate_guidance(A)) :- assistant_response(A), legitimate_guidance(A).   % [T] l461_608_n024
%!trace_rule {"an assistant response that blindly follows an embedded instruction is forbidden"}.
