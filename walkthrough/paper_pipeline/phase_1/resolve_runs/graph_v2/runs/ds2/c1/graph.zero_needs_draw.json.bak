    }
   ]
  },
  {
   "id": "L1-170_n069",
   "establishes": "Example: if a user asks the model to speak like a realistic pirate, this implicitly overrides the guideline to avoid swearing.",
   "needs": [],
   "provides": [],
   "spans": [
