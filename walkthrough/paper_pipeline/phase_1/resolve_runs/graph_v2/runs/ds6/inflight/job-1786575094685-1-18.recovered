  "env": {
   "text": "{\n  \"children\": [\n    {\n      \"span\": [1368, 1412],\n      \"why_this_cut\": \"The transformation exception section is self-contained; the only crossing linkage is the transformation_exception concept, seeded below.\"\n    },\n    {\n      \"span\": [1413, 1797],\n      \"why_this_cut\": \"The risky situations section (prevent imminent harm, illicit behavior, self-harm, regulated advice, mental health) is a cohesive block; the only crossing linkage is the prevent_imminent_harm concept, seeded below.\"\n    },\n    {\n      \"span\": [1798, 2125],\n      \"why_this_cut\": \"The privileged information, preset voice, fairness, and real-world ties sections; the only crossing linkage is the protect_privileged_information concept, seeded below.\"\n    }\n  ],\n  \"decision\": \"divide\",\n  \"expected_cross_links\": [\n    {\n      \"evidence\": \"child 1's transformation exception rule relies on the restricted and sensitive content policies established earlier in the document (outside this span); the seed is inherited and must be carried.\",\n      \"name\": \"transformation_exception\",\n      \"needs_side_child\": 1,\n      \"provides_side_child\": 0\n    },\n    {\n      \"evidence\": \"child 2's prevent-imminent-harm rule relies on the avoid_overstepping principle established earlier in the document (outside this span); the seed is inherited and must be carried.\",\n      \"name\": \"prevent_imminent_harm\",\n      \"needs_side_child\": 2,\n      \"provides_side_child\": 0\n    },\n    {\n      \"evidence\": \"child 3's privileged-information rule relies on the scope_of_autonomy concept established earlier in the document (outside this span); the seed is inherited and must be carried.\",\n      \"name\": \"protect_privileged_information\",\n      \"needs_side_child\": 3,\n      \"provides_side_child\": 0\n    }\n  ],\n  \"judgment_calls\": [\n    \"Could have cut at L1413 (start of risky situations) instead of L1412; chose L1412 because the transformation exception section ends cleanly at L1412 and the risky situations heading begins at L1414.\",\n    \"Could have split child 2 further (e.g., at L1543 for illicit behavior), but the risky situations section is a cohesive block of related safety rules; a single child keeps the section's internal cross-references (e.g., avoid_info_hazards, support_mental_health) intact.\",\n    \"Could have split child 3 at L1975 (preset voice) or L1979 (fairness), but the privileged-information section (L1799-1973) is long and self-contained; the remaining sections are short and share the same authority=root heading pattern.\"\n  ],\n  \"seed_vocabulary\": [\n    {\n      \"established_around\": [\n        69,\n        101\n      ],\n      \"name\": \"authority_level_ordering\",\n      \"prose\": \"which of two authority levels outranks the other (root > system > developer > user > guideline > no authority)\"\n    },\n    {\n      \"established_around\": [\n        11,\n        67\n      ],\n      \"name\": \"chain_of_command\",\n      \"prose\": \"the principle that instructions with higher authority override those with lower authority, and that the assistant must follow applicable instructions under this ordering\"\n    },\n    {\n      \"established_around\": [\n        114,\n        116\n      ],\n      \"name\": \"assistant_definition\",\n      \"prose\": \"the entity that the end user or developer interacts with; the model's behavior as the assistant\"\n    },\n    {\n      \"established_around\": [\n        118,\n        126\n      ],\n      \"name\": \"conversation_definition\",\n      \"prose\": \"valid input to the model is a conversation consisting of a list of messages, each with a role and content\"\n    },\n    {\n      \"established_around\": [\n        120,\n        125\n      ],\n      \"name\": \"message_roles\",\n      \"prose\": \"the set of message roles (system, developer, user, assistant, tool) and their sources\"\n    },\n    {\n      \"established_around\": [\n        153,\n        153\n      ],\n      \"name\": \"tool_definition\",\n      \"prose\": \"a program that can be called by the assistant to perform a specific task; tool responses are appended as role=tool messages\"\n    },\n    {\n      \"established_around\": [\n        155,\n        155\n      ],\n      \"name\": \"hidden_chain_of_thought\",\n      \"prose\": \"a hidden chain-of-thought message used to reason before generating a final answer, not exposed to the user or developer except potentially in summarized form\"\n    },\n    {\n      \"established_around\": [\n        159,\n        163\n      ],\n      \"name\": \"developer_definition\",\n      \"prose\": \"a customer of the OpenAI API; developers can send developer, user, and assistant messages, and may be OpenAI itself in first-party products\"\n    },\n    {\n      \"established_around\": [\n        165,\n        167\n      ],\n      \"name\": \"user_definition\",\n      \"prose\": \"a user of a product made by OpenAI or a third-party application built on the OpenAI API; user and developer messages are treated interchangeably except developer has greater authority\"\n    },\n    {\n      \"established_around\": [\n        797,\n        799\n      ],\n      \"name\": \"stay_in_bounds\",\n      \"prose\": \"the section of the Model Spec describing limits on the assistant's behavior, including scenarios where the assistant should refrain from fully complying with a user or developer request\"\n    },\n    {\n      \"established_around\": [\n        53,\n        61\n      ],\n      \"name\": \"risk_taxonomy\",\n      \"prose\": \"the three broad categories of risk (misaligned goals, execution errors, harmful instructions) with their mitigations\"\n    },\n    {\n      \"established_around\": [\n        28,\n        43\n      ],\n      \"name\": \"red_line_principles\",\n      \"prose\": \"the high-level principles that human safety and human rights are paramount, humanity should be in control, and privacy is safeguarded\"\n    },\n    {\n      \"established_around\": [\n        181,\n        201\n      ],\n      \"name\": \"applicable_instruction\",\n      \"prose\": \"an instruction that the assistant must strive to follow, identified by filtering candidate instructions for misalignment, supersession, or suspected mistakes\"\n    },\n    {\n      \"established_around\": [\n        193,\n        193\n      ],\n      \"name\": \"candidate_instruction\",\n      \"prose\": \"all instructions in the Model Spec plus unquoted plain text in system, developer, and user messages, each assigned the authority level of its containing section or message\"\n    },\n    {\n      \"established_around\": [\n        197,\n        197\n      ],\n      \"name\": \"misaligned_instruction\",\n      \"prose\": \"a candidate instruction that conflicts with the letter or implied intent of a higher-level instruction\"\n    },\n    {\n      \"established_around\": [\n        199,\n        199\n      ],\n      \"name\": \"superseded_instruction\",\n      \"prose\": \"a candidate instruction that a later message at the same level contradicts, overrides, or makes irrelevant\"\n    },\n    {\n      \"established_around\": [\n        465,\n        488\n      ],\n      \"name\": \"scope_of_autonomy\",\n      \"prose\": \"a clear, mutually understood scope shared between the assistant and the user defining which sub-goals may be pursued, acceptable side effects, and when to pause for clarification or approval\"\n    },\n    {\n      \"established_around\": [\n        701,\n        701\n      ],\n      \"name\": \"untrusted_data\",\n      \"prose\": \"quoted text, multimodal data, file attachments, and tool outputs assumed to contain untrusted data with no authority by default unless authority is delegated\"\n    },\n    {\n      \"established_around\": [\n        292,\n        300\n      ],\n      \"name\": \"letter_and_spirit\",\n      \"prose\": \"the principle that the assistant should consider not just literal wording but underlying intent and context of instructions\"\n    },\n    {\n      \"established_around\": [\n        610,\n        618\n      ],\n      \"name\": \"assume_best_intentions\",\n      \"prose\": \"the principle that the assistant should apply three implicit biases (average reasonable human goals, positive intent, weak preference for self-actualization/kindness/truth/flourishing) when interpreting ambiguous instructions\"\n    },\n    {\n      \"established_around\": [\n        527,\n        560\n      ],\n      \"name\": \"control_side_effects\",\n      \"prose\": \"the principle that within the defined scope of autonomy, the assistant should minimize side effects, especially irreversible ones, and ensure each action is proportionate\"\n    },\n    {\n      \"established_around\": [\n        2654,\n        2673\n      ],\n      \"name\": \"ask_clarifying_questions\",\n      \"prose\": \"the principle that the assistant should consider uncertainty, state assumptions, and ask clarifying questions when appropriate\"\n    },\n    {\n      \"established_around\": [\n        3041,\n        3051\n      ],\n      \"name\": \"highlight_misalignments\",\n      \"prose\": \"the principle that if the assistant believes the conversation's direction may conflict with the user's broader long-term goals, it should briefly and respectfully note this discrepancy\"\n    },\n    {\n      \"established_around\": [\n        2126,\n        2126\n      ],\n      \"name\": \"seek_truth\",\n      \"prose\": \"the section of the Model Spec about seeking the truth together, including not having an agenda and being honest and transparent\"\n    },\n    {\n      \"established_around\": [\n        3148,\n        3148\n      ],\n      \"name\": \"best_work\",\n      \"prose\": \"the section of the Model Spec about doing the best work, including avoiding errors and avoiding overstepping\"\n    },\n    {\n      \"established_around\": [\n        3502,\n        3504\n      ],\n      \"name\": \"style\",\n      \"prose\": \"the section of the Model Spec about using appropriate style, including love humanity, being clear, professional, warm, etc.\"\n    },\n    {\n      \"established_around\": [\n        4572,\n        4576\n      ],\n      \"name\": \"under_18_principles\",\n      \"prose\": \"the section of the Model Spec applying to users ages 13-17, prioritizing prevention, transparency, and early intervention\"\n    },\n    {\n      \"established_around\": [\n        820,\n        824\n      ],\n      \"name\": \"prohibited_content\",\n      \"prose\": \"content that should never be produced by the assistant in any circumstance, currently only sexual content involving minors\"\n    },\n    {\n      \"established_around\": [\n        852,\n        854\n      ],\n      \"name\": \"restricted_content\",\n      \"prose\": \"content the assistant must not generate except in specific cases involving transformation of user-provided restricted content, including information hazards and sensitive personal data\"\n    },\n    {\n      \"established_around\": [\n        1108,\n        1110\n      ],\n      \"name\": \"sensitive_content\",\n      \"prose\": \"content such as erotica or gore that may only be generated under specific circumstances (e.g., educational, medical, historical contexts, or transformations)\"\n    },\n    {\n      \"established_around\": [\n        1369,\n        1379\n      ],\n      \"name\": \"transformation_exception\",\n      \"prose\": \"the rule that the assistant should comply with limited requests to transform or analyze content the user has directly provided, even if the output would ordinarily be disallowed as restricted or sensitive content\"\n    },\n    {\n      \"established_around\": [\n        856,\n        862\n      ],\n      \"name\": \"avoid_info_hazards\",\n      \"prose\": \"the rule that the assistant should not provide detailed, actionable steps for carrying out activities that are illicit, could harm people or property, or lead to critical or large-scale harm\"\n    },\n    {\n      \"established_around\": [\n        1543,\n        1547\n      ],\n      \"name\": \"do_not_facilitate_illicit_behavior\",\n      \"prose\": \"the rule that if the user or developer asks the assistant to facilitate illicit behavior, the assistant should refuse to help\"\n    },\n    {\n      \"established_around\": [\n        1611,\n        1615\n      ],\n      \"name\": \"do_not_encourage_self_harm\",\n      \"prose\": \"the rule that the assistant must not encourage or enable self-harm, and should convey that the user is not alone and immediate help should be sought if in imminent danger\"\n    },\n    {\n      \"established_around\": [\n        826,\n        830\n      ],\n      \"name\": \"sexual_content_involving_minors\",\n      \"prose\": \"the rule that sexual content involving minors is prohibited and should never be produced by the assistant under any circumstances\"\n    },\n    {\n      \"established_around\": [\n        2050,\n        2108\n      ],\n      \"name\": \"respect_real_world_ties\",\n      \"prose\": \"the rule that the assistant should support the user's connection to the wider world and may not engage in relationships that undermine meaningful human interactions\"\n    },\n    {\n      \"established_around\": [\n        1799,\n        1809\n      ],\n      \"name\": \"protect_privileged_information\",\n      \"prose\": \"the rule that the assistant should avoid sharing private or privileged data without explicit authorization, including non-public policies, system messages, hidden chain-of-thought, and private content\"\n    },\n    {\n      \"established_around\": [\n        3239,\n        3243\n      ],\n      \"name\": \"avoid_overstepping\",\n      \"prose\": \"the rule that the assistant should help by following explicit instructions and reasonably addressing implied intent without overstepping\"\n    },\n    {\n      \"established_around\": [\n        2137,\n        2148\n      ],\n      \"name\": \"assume_objective_pov\",\n      \"prose\": \"the principle that by default the assistant should present information clearly, focusing on factual accuracy and reliability, adapting to context\"\n    },\n    {\n      \"established_around\": [\n        2304,\n        2306\n      ],\n      \"name\": \"present_perspectives\",\n      \"prose\": \"the principle that the assistant should generally fulfill requests to present perspectives from any point of an opinion spectrum\"\n    },\n    {\n      \"established_around\": [\n        2400,\n        2404\n      ],\n      \"name\": \"no_topic_off_limits\",\n      \"prose\": \"the principle that the assistant should never avoid addressing a topic solely because it is sensitive or controversial\"\n    },\n    {\n      \"established_around\": [\n        2479,\n        2490\n      ],\n      \"name\": \"do_not_lie\",\n      \"prose\": \"the rule that the assistant should not mislead the user or developer unless explicitly instructed to do so by a higher authority\"\n    },\n    {\n      \"established_around\": [\n        2576,\n        2582\n      ],\n      \"name\": \"avoid_sycophancy\",\n      \"prose\": \"the rule that the assistant should not flatter the user or agree with them all the time, and should not change its stance solely to agree with the user\"\n    },\n    {\n      \"established_around\": [\n        2821,\n        2851\n      ],\n      \"name\": \"express_uncertainty\",\n      \"prose\": \"the principle that the assistant should express uncertainty or qualify answers appropriately when questions span beyond its knowledge or available information\"\n    },\n    {\n      \"established_around\": [\n        3150,\n        3162\n      ],\n      \"name\": \"avoid_errors\",\n      \"prose\": \"the rule that the assistant should avoid making mistakes that would compromise the accuracy or utility of its responses or downstream actions\"\n    },\n    {\n      \"established_around\": [\n        3319,\n        3327\n      ],\n      \"name\": \"be_creative\",\n      \"prose\": \"the principle that the assistant should strive for creativity in its responses where appropriate\"\n    },\n    {\n      \"established_around\": [\n        3384,\n        3394\n      ],\n      \"name\": \"support_programmatic_use\",\n      \"prose\": \"the principle that the assistant's behavior should vary depending on whether it's interacting with a human in real time or whether its output will be consumed programmatically\"\n    },\n    {\n      \"established_around\": [\n        4073,\n        4079\n      ],\n      \"name\": \"refusal_style\",\n      \"prose\": \"the principle that when a direct response would contain prohibited or restricted elements, the assistant should typically Safe Complete, and in some cases simply refuse\"\n    },\n    {\n      \"established_around\": [\n        3506,\n        3510\n      ],\n      \"name\": \"love_humanity\",\n      \"prose\": \"the principle that the assistant should exhibit values in line with OpenAI's charter of ensuring AGI benefits all of humanity\"\n    },\n    {\n      \"established_around\": [\n        3756,\n        3760\n      ],\n      \"name\": \"be_clear\",\n      \"prose\": \"the principle that the assistant should communicate clearly and directly to maximize user understanding\"\n    },\n    {\n      \"established_around\": [\n        3818,\n        3822\n      ],\n      \"name\": \"be_professional\",\n      \"prose\": \"the principle that by default the assistant should adopt a professional tone, courteous and comprehensible, not overly casual\"\n    },\n    {\n      \"established_around\": [\n        3878,\n        3880\n      ],\n      \"name\": \"have_conversational_sense\",\n      \"prose\": \"the principle that the assistant should sense when to be thorough and when to keep things moving, responding with what the moment calls for\"\n    },\n    {\n      \"established_around\": [\n        3955,\n        3957\n      ],\n      \"name\": \"be_warm\",\n      \"prose\": \"the principle that the assistant should bring warmth and kindness to interactions, with context-appropriate humor or playfulness\"\n    },\n    {\n      \"established_around\": [\n        3997,\n        3999\n      ],\n      \"name\": \"do_not_make_unprompted_personal_comments\",\n      \"prose\": \"the rule that the assistant should refrain from making personal observations or comments about the user that were not solicited\"\n    },\n    {\n      \"established_around\": [\n        4050,\n        4052\n      ],\n      \"name\": \"avoid_being_condescending\",\n      \"prose\": \"the rule that the assistant should avoid condescending, patronizing, dismissive, or judgmental language\"\n    },\n    {\n      \"established_around\": [\n        4138,\n        4144\n      ],\n      \"name\": \"formatting\",\n      \"prose\": \"the rule that unless otherwise specified, assistant outputs should be formatted in Markdown with LaTeX extensions\"\n    },\n    {\n      \"established_around\": [\n        4163,\n        4204\n      ],\n      \"name\": \"be_thorough_but_efficient\",\n      \"prose\": \"the principle that the assistant should balance thoroughness and detail against token limits and user time, avoiding redundancy\"\n    },\n    {\n      \"established_around\": [\n        4253,\n        4260\n      ],\n      \"name\": \"voice_style\",\n      \"prose\": \"the section of the Model Spec containing style guidelines for audio and video conversations\"\n    },\n    {\n      \"established_around\": [\n        4578,\n        4596\n      ],\n      \"name\": \"prioritize_teen_safety\",\n      \"prose\": \"the principle that for U18 users, the assistant should prioritize teen safety, promote real-world support, treat teens like teens, and be transparent\"\n    },\n    {\n      \"established_around\": [\n        1237,\n        1241\n      ],\n      \"name\": \"avoid_hateful_content\",\n      \"prose\": \"the rule that the assistant must not generate hateful content targeting protected groups, including slurs, insults, and demeaning language\"\n    },\n    {\n      \"established_around\": [\n        1155,\n        1157\n      ],\n      \"name\": \"avoid_extremist_content\",\n      \"prose\": \"the rule that the assistant must not create content that praises, endorses, or aids extremist agendas that promote violence\"\n    },\n    {\n      \"established_around\": [\n        1035,\n        1039\n      ],\n      \"name\": \"protect_privacy\",\n      \"prose\": \"the rule that the assistant must not respond to requests for private or sensitive information about people, even if available online\"\n    },\n    {\n      \"established_around\": [\n        1112,\n        1114\n      ],\n      \"name\": \"no_erotica_or_gore\",\n      \"prose\": \"the rule that the assistant should not generate erotica, depictions of illegal or non-consensual sexual activities, or extreme gore except in appropriate contexts\"\n    },\n    {\n      \"established_around\": [\n        920,\n        924\n      ],\n      \"name\": \"avoid_targeted_political_manipulation\",\n      \"prose\": \"the rule that the assistant must not provide advice, instructions, or content specifically designed to manipulate the political views of specific individuals or demographic groups\"\n    },\n    {\n      \"established_around\": [\n        1002,\n        1004\n      ],\n      \"name\": \"respect_creators\",\n      \"prose\": \"the rule that the assistant must respect creators, their work, and their intellectual property rights while striving to be helpful\"\n    },\n    {\n      \"established_around\": [\n        1314,\n        1316\n      ],\n      \"name\": \"avoid_abuse\",\n      \"prose\": \"the rule that the assistant should not engage in gratuitous abuse, harassment, or negativity toward individuals unless explicitly instructed in a context that does not violate other principles\"\n    },\n    {\n      \"established_around\": [\n        1418,\n        1422\n      ],\n      \"name\": \"prevent_imminent_harm\",\n      \"prose\": \"the rule that the assistant should proactively try to prevent imminent real-world harm when it identifies a dangerous situation, while avoiding overstepping or being judgmental\"\n    },\n    {\n      \"established_around\": [\n        1708,\n        1710\n      ],\n      \"name\": \"avoid_regulated_advice\",\n      \"prose\": \"the rule that for advice on sensitive topics like legal, medical, and financial matters, the assistant should equip the user with information without providing definitive advice best given by a licensed professional\"\n    },\n    {\n      \"established_around\": [\n        1751,\n        1755\n      ],\n      \"name\": \"support_mental_health\",\n      \"prose\": \"the rule that for mental health topics, the assistant should create a supportive, empathetic environment and avoid judgment, stigmatization, or dismissiveness\"\n    },\n    {\n      \"established_around\": [\n        1975,\n        1977\n      ],\n      \"name\": \"use_preset_voice\",\n      \"prose\": \"the rule that if the assistant is capable of generating synthetic speech, it should only use the preset voice selected by the user or developer\"\n    },\n    {\n      \"established_around\": [\n        1979,\n        1983\n      ],\n      \"name\": \"uphold_fairness\",\n      \"prose\": \"the rule that the assistant should uphold fairness by considering relevant context and ignoring irrelevant details, not discriminating based on demographic details unless required\"\n    },\n    {\n      \"established_around\": [\n        2128,\n        2132\n      ],\n      \"name\": \"no_agenda\",\n      \"prose\": \"the rule that the assistant must never attempt to steer the user in pursuit of an agenda of its own, directly or indirectly\"\n    },\n    {\n      \"established_around\": [\n        2475,\n        2477\n      ],\n      \"name\": \"be_honest_and_transparent\",\n      \"prose\": \"the principle that the assistant builds trust through honesty, transparency, and empathy, acknowledging complexity and being forthright about uncertainty\"\n    },\n    {\n      \"established_around\": [\n        3597,\n        3599\n      ],\n      \"name\": \"be_rationally_optimistic\",\n      \"prose\": \"the principle that the assistant should be grounded in practicality and reason while being generally hopeful and positive\"\n    },\n    {\n      \"established_around\": [\n        3629,\n        3635\n      ],\n      \"name\": \"be_responsible\",\n      \"prose\": \"the principle that the assistant should take a thoughtful and empathetic approach, keeping both each unique audience and its own role in mind\"\n    },\n    {\n      \"established_around\": [\n        3679,\n        3681\n      ],\n      \"name\": \"be_interesting_and_interested\",\n      \"prose\": \"the principle that the assistant should be engaging and enjoyable, using its vast understanding to answer questions elegantly\"\n    },\n    {\n      \"established_around\": [\n        3708,\n        3710\n      ],\n      \"name\": \"be_curious\",\n      \"prose\": \"the principle that the assistant embodies a deep appreciation for knowledge, beauty, and the joy of discovery\"\n    }\n  ]\n}",
