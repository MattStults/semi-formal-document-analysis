   "text": "{\n  \"children\": [\n    {\n      \"span\": [4252, 4363],\n      \"why_this_cut\": \"Section intro and the 'Use accents respectfully' subsection; the only crossing linkage is the voice_style section concept (seeded) and the authority=user heading metadata, both seeded below.\"\n    },\n    {\n      \"span\": [4364, 4571],\n      \"why_this_cut\": \"The remaining three subsections (Be concise and conversational, Adapt length and structure, Handle interruptions, Respond appropriately to audio testing); they share the voice_style section concept and the guideline authority heading metadata, seeded below.\"\n    }\n  ],\n  \"decision\": \"divide\",\n  \"expected_cross_links\": [\n    {\n      \"evidence\": \"Both children's rules are style guidelines within the voice_style section; child 2's rules need the section concept established by child 1's intro.\",\n      \"name\": \"voice_style\",\n      \"needs_side_child\": 2,\n      \"provides_side_child\": 1\n    },\n    {\n      \"evidence\": \"Child 1's 'Use accents respectfully' heading carries authority=user, which governs its rules; child 2's headings carry authority=guideline. The authority concept is established in the document's broader structure (outside this span), so both children need it; no child provides it.\",\n      \"name\": \"authority_level_ordering\",\n      \"needs_side_child\": 1,\n      \"provides_side_child\": 2\n    }\n  ],\n  \"judgment_calls\": [\n    \"Cut at L4363 (before the 'Be concise and conversational' heading) rather than at L4410, because the first child is a self-contained unit (intro + one subsection) and the second child holds the remaining four subsections; a cut at L4410 would have split the 'Be concise' subsection's examples from its rule.\",\n    \"The authority_level_ordering seed is inherited from outside this span; both children need it (for heading metadata authority=user/guideline), but neither provides it \u2014 it remains a dangling need for the parent to resolve.\",\n    \"The voice_style seed is inherited; child 1 establishes the section's existence and scope, child 2's rules rely on it.\"\n  ],\n  \"seed_vocabulary\": [\n    {\n      \"established_around\": [4255, 4255],\n      \"name\": \"voice_style\",\n      \"prose\": \"the section of the Model Spec containing style guidelines for audio and video conversations\"\n    },\n    {\n      \"established_around\": [4262, 4262],\n      \"name\": \"authority_level_ordering\",\n      \"prose\": \"which of two authority levels outranks the other\"\n    }\n  ]\n}",
