#!/bin/sh
# Blocks a commit that touches a file the staleness guard watches, unless that
# file is at its recorded review point.
#
# Install:   ln -sf ../../walkthrough/model/hooks/pre-commit .git/hooks/pre-commit
# Remove:    rm .git/hooks/pre-commit
#
# ⭐ On 2026-08-07 the guard was RIGHT and RED for two hours and nobody looked,
# because this hook had never been installed. Check that it is:
#     ls -l .git/hooks/pre-commit
#
# Scoped: silent unless a watched file is staged, so it does not affect
# unrelated commits. Ask the guard which files it watches rather than keeping a
# second copy of the list here — three copies of that list is how they drift.
#
# GUARD_STAGED_FILES overrides the staged list. It exists so this script can be
# tested without staging anything or running a commit; leave it unset in use.
# Either source is NEWLINE-separated, the shape of `git diff --cached
# --name-only` — the only shape that can represent a path with a space.
staged="${GUARD_STAGED_FILES-$(git diff --cached --name-only)}"
[ -z "$staged" ] && exit 0

# Split on NEWLINES only, so `a file.md` reaches the guard as ONE argument.
# (G10, 2026-08-15: unquoted $staged word-split on spaces, so a staged path
# with a space became two bogus paths, matched nothing, and the gate skipped
# a file it was supposed to run for.)
ifs_keep="$IFS"
IFS='
'
set -f            # no pathname expansion of the split words either
set -- $staged
set +f
IFS="$ifs_keep"

# Ask the guard whether any staged file is watched. THREE outcomes, and they
# must stay three (G2, 2026-08-15 — this line used to be
# `python3 ... || exit 0`, so a missing python3 (127), a crashed guard (1)
# and "nothing watched" all exited 0 and the commit went through; that is
# the 2026-08-07 incident with the seeing removed):
#   0  something is watched          -> run the gates below
#   3  nothing is watched            -> silent exit (guard.py's reserved
#                                       skip code; it is not 1, because 1 is
#                                       also Python's crash exit)
#   anything else                    -> the guard could NOT run. BLOCK.
python3 walkthrough/model/guard.py --watches "$@"
rc=$?
if [ "$rc" -eq 3 ]; then
  exit 0
fi
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "COMMIT BLOCKED. The staleness guard could not answer whether a staged" >&2
  echo "file is watched (guard exited $rc): python3 missing from PATH, guard.py" >&2
  echo "crashed, or the watch list is broken. 'Could not run' is not a pass —" >&2
  echo "it is indistinguishable from 'no guard installed', the failure of" >&2
  echo "2026-08-07. Fix the environment (python3 must resolve) and retry, or" >&2
  echo "run the guard by hand:  python3 walkthrough/model/guard.py" >&2
  echo "Bypass (records nothing, and nobody will know):  git commit --no-verify" >&2
  exit 1
fi

echo "a watched file changed — checking the prompt's examples, then staleness"

# ---------------------------------------------------------------------------
# 1. The prompt's own worked examples, run through stage 2.
#
# An example is an instruction with a picture attached. A module shown as good
# that our own checks would reject tells the model, in the most credible form
# available, that the failure is fine — and nothing about reading the file
# reveals it. This fires on the same staged set the guard watches, so there is
# no second list to drift.
#
# ⛔ A missing venv BLOCKS rather than skips. "The checker could not run" must
# never be reachable from the same exit code as "the checks passed"; that
# equivalence is the failure this directory keeps re-learning.
# ---------------------------------------------------------------------------
VENV=semi-formal-experiment/.venv/bin/python
if [ ! -x "$VENV" ]; then
  echo ""
  echo "COMMIT BLOCKED. Cannot verify the prompt's worked examples: no venv at"
  echo "    $VENV"
  echo "Create it:  python3 -m venv semi-formal-experiment/.venv &&"
  echo "            semi-formal-experiment/.venv/bin/pip install pytest clingo"
  exit 1
fi
"$VENV" -m pytest walkthrough/paper_pipeline/phase_1/test_prompt_examples.py \
        -q --no-header || {
  echo ""
  echo "COMMIT BLOCKED. A worked example in the prompt does not survive stage 2,"
  echo "or a shape the prompt must demonstrate is no longer demonstrated."
  echo "The model imitates these examples; an example our checks reject teaches"
  echo "the failure. Fix the example — do not weaken the test."
  exit 1
}

python3 walkthrough/model/guard.py || {
  echo ""
  echo "COMMIT BLOCKED. A file transcribed from the design is not at its"
  echo "recorded review point. Re-read it against the design, then accept it"
  echo "BY NAME:"
  echo "    python3 walkthrough/model/guard.py --accept <path>"
  echo "Bypass (records nothing, and nobody will know):  git commit --no-verify"
  exit 1
}
