#!/bin/sh
# Blocks a commit that touches the pipeline design or its formal model without
# the model having been reviewed against the change.
#
# Install:   ln -sf ../../walkthrough/model/hooks/pre-commit .git/hooks/pre-commit
# Remove:    rm .git/hooks/pre-commit
#
# Scoped: silent unless one of the watched files is staged, so it does not
# affect unrelated commits.
# Ask the guard which files it watches rather than keeping a second copy of the
# list here. Three copies of that list is how they drift apart.
staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0
python3 walkthrough/model/guard.py --watches $staged || exit 0

echo "pipeline design or model changed — running the guard"
python3 walkthrough/model/guard.py || {
  echo ""
  echo "COMMIT BLOCKED. The formal model is stale or reporting findings."
  echo "Either update walkthrough/model/pipeline.lp, or confirm it needs no change:"
  echo "    python3 walkthrough/model/guard.py --accept"
  echo "Bypass (records nothing):  git commit --no-verify"
  exit 1
}
