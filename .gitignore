# Vendored third-party checkouts (each carries its own .git); 234MB.
# The spec text we actually depend on is vendored under specs/ instead.
external/

# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Binary pickles: not reviewable in a diff, and regenerable.
*.pkl
.claude/worktrees/

# Agent tooling state (session/agent metadata, not project content).
.qwen/

# macOS
.DS_Store

# Working backups from in-place document rewrites
*.presplice
